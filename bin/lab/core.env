# Runtime env for a clean-core lab row (copied to `<row>/.env`).
#
# This file can switch RUNTIME behaviour, not DEPENDENCIES. A module is code:
# it exists in `<row>/src/Modules/...` or it does not, and `php bin/cms
# module:add` is what puts it there. `bin/lab/core-surfaces.sh` does that from
# the surface names, then copies this file in so every row boots the same way.
#
# Deliberately different from a production row:
#   - development, so an exception page names the file and the line;
#   - page cache off, so a row never answers from a previous row's render;
#   - warnings only, because a lab row is measured, not debugged;
#   - its own session cookie name, so rows on other ports cannot share auth.
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Bratislava
LOG_LEVEL=warning
PAGE_CACHE=false
SESSION_NAME=core_lab
SESSION_LIFETIME=1209600
TRUSTED_PROXIES=
TRUSTED_HOSTS=
