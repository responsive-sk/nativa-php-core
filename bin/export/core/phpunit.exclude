# Tests the nativa-core export does NOT CARRY, one path and one reason per line.
#
# These are not failing tests. Their SUBJECT is the development of
# nativa-php-core: an approval record under docs/, the Lekalo model, the
# OpenSpec tree, or the article corpus. That material is not shipped, so the
# test would fail on a missing fixture rather than on a defect.
#
# The exporter asserts every path here exists in the archive, ends in Test.php
# and is removed before the tree is published. A test that no longer exists is a
# stale entry and fails; a file left in the archive would run in CI against a
# subject that is not there.
#
# Format: <repo-relative test path> [# reason]
tests/Architecture/KernelShapeTest.php # its approval record is docs/kernel-shape.md
tests/Architecture/MagoScopeContractTest.php # its analysis is docs/mago-evaluation.md
tests/Architecture/NameOwnershipContractTest.php # its ledger is docs/name-ownership.md
tests/Architecture/PersistedBooleanContractTest.php # its vocabulary is docs/boolean-vocabulary.md
tests/Architecture/ToolchainRegistryContractTest.php # it asserts this tree's 25-target gate floor
tests/Architecture/SlovakProseContractTest.php # its corpus is storage/blog, docs/clanky and storage/pages
tests/Architecture/ModelCatalogueContractTest.php # it reads lekalo/modules/
tests/Architecture/ModelPayloadContractTest.php # it reads lekalo/modules/
tests/Architecture/ModelReferenceContractTest.php # it reads lekalo/modules/
tests/Architecture/ScenarioTestBindingContractTest.php # it reads openspec/ and would skip on every run here
tests/Content/EmDashContractTest.php # it ratchets the em dash count of docs/
tests/Content/ProseRhythmContractTest.php # its wrapped list is docs/ files

# The catalogue is not the 26-module development tree. These tests measure the
# whole tree or a subject the export deliberately does not ship; the admin
# stack itself now ships, so its tests run.
tests/Architecture/StatementHelperContractTest.php # its helper set spans 16 modules; the catalogue carries 8 of them
tests/Discovery/DiscoveryCacheTest.php # it installs Scratch from the catalogue
tests/Modules/ModuleLifecycleTest.php # it installs and removes Scratch from the catalogue
tests/Architecture/ModuleCatalogueShapeTest.php # it asserts the four theme groups this tree does not carry
tests/Theme/ThemeClassOwnershipTest.php # its shared-contract ledger needs two themes; one theme cannot collide with itself
tests/Theme/FontPreloadTest.php # it needs a theme that declares a webfont; Nativa declares none by design
modules/PageCache/tests/PageCacheInvalidationTest.php # two cases read modules/Blog call sites, which the catalogue does not carry
