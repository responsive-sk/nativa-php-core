{
    "schema_version": 1,
    "slug": "ohniva-show",
    "name": "nativa-ohniva-show",
    "repository": "responsive-sk/nativa-ohniva-show",
    "description": "ohniva-show.sk Nativa site: pages, blog and forms on Cardboard, generated from nativa-php-core.",
    "source": "https://github.com/responsive-sk/nativa-php-core",
    "visibility": "private",
    "marker": ".nativa-ohniva-show-export.json",
    "default_target": "../nativa-ohniva-show",
    "install_modules": true,
    "migrate_before_tests": true,
    "minimum_tests": 600,
    "content_seed": "bin/export/ohniva-show/seed",
    "deploy": {
        "theme": "boson",
        "site_name": "ohniva-show.sk",
        "timezone": "Europe/Bratislava"
    },
    "modules": [
        "Audit",
        "Auth",
        "Blog",
        "Boson",
        "Cardboard",
        "ContentLocale",
        "Forms",
        "Locales",
        "Markdown",
        "Media",
        "Navigation",
        "Notifications",
        "Outbox",
        "PageCache",
        "Pages",
        "Pagination",
        "Queue",
        "Security",
        "Settings",
        "Uploads",
        "Users",
        "Validation"
    ],
    "required_paths": [
        "src/Modules/Core",
        "src/Modules/Database",
        "src/Modules/Tooling",
        "src/Modules/KernelTheme",
        "src/Modules/Core/Interfaces/HTTP/Theme",
        "modules",
        "Frontend/packages",
        "Frontend/packages/boson",
        "public/index.php",
        "public/fonts",
        "public/dist/moonshine",
        "bin/cms",
        "config",
        "config/deploy.php",
        "tests",
        "LICENSE",
        "storage/pages",
        "storage/blog",
        "storage/blog-images",
        "src/Modules/Cardboard",
        "src/Modules/Themes/Boson"
    ],
    "pruned_paths": [
        "docs",
        "openspec",
        "lekalo",
        "lekalo.lock",
        ".ai-factory",
        ".codex",
        "CONTRIBUTING.md",
        "themes",
        "fixtures",
        "public/demo",
        "bin/generate",
        "bin/lab",
        "bin/build/build-prod.sh",
        "bin/build/clickhouse-smoke.sh",
        "bin/build/mark-smoke.sh",
        "bin/build/migrate-sqlite-defaults.sh",
        "bin/build/kernel-size.sh",
        "bin/build/render-theme-pages.php",
        "bin/build/lekalo-modules.sh",
        "bin/build/mago-modules-report.sh",
        "bin/ops/lekalo-reports.php",
        "bin/build/export-core.sh",
        "bin/build/publish-core.sh",
        "bin/ops/export-core-registry.php",
        "bin/ops/export-core-verify.php",
        "bin/export",
        "modules/Clickhouse",
        "modules/Scheduler",
        "modules/Scratch",
        "modules/Themes/Erik",
        "modules/Themes/Griffe",
        "modules/Themes/Jednotka",
        "modules/Themes/Mono",
        "modules/Themes/Nativa",
        "public/dist/nativa",
        "public/dist/griffe",
        "public/dist/mono",
        "Frontend/packages/basic",
        "Frontend/packages/erik",
        "Frontend/packages/griffe",
        "Frontend/packages/jednotka",
        "Frontend/packages/magazine",
        "Frontend/packages/minimal",
        "Frontend/packages/mono",
        "Frontend/packages/nativa",
        ".github/workflows/gallery-pages.yml",
        ".github/workflows/gallery-pages-check.yml",
        ".github/workflows/themes-publish.yml",
        "bin/build/publish-themes.sh"
    ]
}
