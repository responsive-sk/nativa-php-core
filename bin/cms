#!/usr/bin/env php
<?php

declare(strict_types = 1);

/*
 * bin/cms — the kernel's module tool. Plain PHP, zero dependencies.
 *
 * The kernel runtime has no Composer packages, so this tool cannot be a
 * symfony/console application the way the showcase's bin/cms is: what manages
 * modules must run in a tree whose vendor/ directory may not exist. Nine
 * commands, argv-parsed, exit 0 on success and 1 on refusal or error:
 *
 *   module:list              installed + catalogued modules
 *   module:show <Name>       the manifest — what WOULD be installed, before anything is copied
 *   module:add <Name>        copy the slice in (refuses an incomplete closure by name)
 *   module:remove <Name>     delete the slice (refuses while another module imports it)
 *   migrate                  run every module migrator (the first-request run, forced)
 *   schedule:run             run the Scheduler timetable entries due now (needs the Scheduler module)
 *   queue:work               work one batch of queued jobs (needs the Queue module)
 *   discovery:clear          delete the discovery cache (rebuilt on the next request)
 *   discovery:status         whether the discovery cache exists and is fresh
 *
 * The lifecycle itself lives in ModuleInstaller (a service the test harness
 * drives in-process); this script only prints results and maps refusals to
 * exit codes. The wording of every message is owned by the service — what
 * the CLI prints and what the tests assert is the same string.
 *
 * Two of the commands DELIVER rather than manage — `schedule:run` and
 * `queue:work` — so both call `wire_module_handlers()` from
 * `src/composition.php` first. A handler pairing that only the web process
 * registers leaves a CLI drain with an empty handler map, and every message
 * lands as `No handler registered for event type` while the HTTP responses
 * still look healthy (Boot 16). The pairing lives in one file; this script is
 * one of the processes that has to run it.
 */

use Modules\Core\Interfaces\CLI\CliOutput;
use Modules\Core\Interfaces\CLI\Support\DatabaseMigrator;
use Modules\Database\Infrastructure\Persistence\DatabaseConnectionManager;
use Modules\Tooling\ModuleCatalog;
use Modules\Tooling\ModuleInstaller;
use Modules\Tooling\ModuleManifest;

require_once __DIR__ . '/../src/init.php';
require_once __DIR__ . '/../src/composition.php';

/** @return never */
function fail(string $message): void
{
    fwrite(STDERR, 'cms: ' . $message . PHP_EOL);
    exit(1);
}

function out(string $message = ''): void
{
    fwrite(STDOUT, $message . PHP_EOL);
}

function printManifest(ModuleManifest $manifest, string $where): void
{
    out(sprintf('Module %s (%s)', $manifest->name, $where));
    out(sprintf('  source:      %s', $manifest->sourceDir));
    out(sprintf('  sqlite file: storage/data/%s', $manifest->sqliteFile()));

    foreach ($manifest->routes as $route) {
        out(sprintf(
            '  route:       %s %s  (name: %s, in %s)',
            $route['method'],
            $route['path'],
            $route['name'] ?? '(none)',
            $route['file'],
        ));
    }

    $lists = [
        'migrator'       => $manifest->migrators,
        'middleware'     => $manifest->middleware,
        'nav badge'      => $manifest->navBadges,
        'markdown block' => $manifest->markdownBlocks,
        'shell provider' => $manifest->shellProviders,
        'theme module'   => $manifest->themeModules,
        'asset'          => $manifest->assets,
    ];

    foreach ($lists as $kind => $files) {
        foreach ($files as $file) {
            out(sprintf('  %-14s %s', $kind . ':', $file));
        }
    }

    $closure = $manifest->closure();

    out('  closure:     ' . ([] === $closure ? '(none — a leaf)' : implode(', ', $closure)));
    out('  module.json: ' . (null === $manifest->extra ? 'absent (scan alone decides)' : 'present'));

    if ([] === $manifest->routes && [] === $manifest->migrators && [] === $manifest->middleware
        && [] === $manifest->navBadges && [] === $manifest->markdownBlocks
        && [] === $manifest->shellProviders && [] === $manifest->themeModules && [] === $manifest->assets
    ) {
        out('  contributes: nothing the scan can see');
    }
}

function cmdList(ModuleCatalog $catalog): void
{
    $installed = $catalog->installed();
    $catalogued = $catalog->catalogued();

    out('Installed (' . count($installed) . '): ' . ([] === $installed ? '(none — kernel only)' : implode(', ', $installed)));
    out('Catalogued (' . count($catalogued) . '): ' . ([] === $catalogued ? '(empty catalog)' : implode(', ', $catalogued)));
}

function cmdShow(ModuleCatalog $catalog, string $name): void
{
    try {
        if ($catalog->isInstalled($name)) {
            printManifest($catalog->installedManifest($name), 'installed');

            return;
        }

        printManifest($catalog->manifest($name), 'catalog — not installed');
    } catch (RuntimeException $e) {
        fail($e->getMessage());
    }
}

function cmdAdd(ModuleInstaller $installer, string $name): void
{
    try {
        $result = $installer->add($name);
    } catch (RuntimeException $e) {
        fail($e->getMessage());
    }

    out(sprintf("Installed '%s': %d file(s) copied to src/Modules/%s/.", $name, $result['copied'], $name));
    out(sprintf('Page cache flushed (%d entr%s removed) — routes are reachable on the next request.', $result['flushed'], 1 === $result['flushed'] ? 'y' : 'ies'));
}

function cmdRemove(ModuleInstaller $installer, string $name, bool $force): void
{
    try {
        $result = $installer->remove($name, $force);
    } catch (RuntimeException $e) {
        fail($e->getMessage());
    }

    out(sprintf("Removed '%s': the slice is gone.", $name));
    out(sprintf('Page cache flushed (%d entr%s removed).', $result['flushed'], 1 === $result['flushed'] ? 'y' : 'ies'));

    // The code is not the data: what the module WROTE stays where it is, and
    // the operator is told exactly what and where — a removal that silently
    // deletes the only copy of someone's data is not a removal, it is loss.
    if ([] === $result['leftovers']) {
        out('No leftover data: no module database, no tracked uploads, no frontend package entry in this tree.');
    } else {
        out('Left behind (not deleted):');
        foreach ($result['leftovers'] as $leftover) {
            out('  - ' . $leftover);
        }
    }

    if ([] !== $result['holders']) {
        out('Note: removed with --force while still imported by:');
        foreach ($result['holders'] as $holder) {
            out('  - ' . $holder);
        }
    }
}

function usage(): void
{
    out('Usage: php bin/cms <command> [args]');
    out('');
    out('  module:list              installed + catalogued modules');
    out('  module:show <Name>       the manifest before anything is copied');
    out('  module:add <Name>        install a module (refuses an incomplete closure)');
    out('  module:remove <Name> [--force]  remove a module (refuses while imported)');
    out('  migrate                  run every module migrator (the first-request run, forced)');
    out('  schedule:run             run due Scheduler timetable entries (exit 1 on any failure)');
    out('  queue:work [<name>] [--limit=N]  work one batch of queued jobs (exit 1 on a parked job)');
    out('  discovery:clear          delete the discovery cache (rebuilt on the next request)');
    out('  discovery:status         whether the discovery cache exists and is fresh');
}

/**
 * Run every module migrator — the same idempotent run the HTTP bootstrap does
 * on its first request, without the marker in the way.
 *
 * The marker is invalidated when a module is installed or removed, so this is
 * not the everyday path; it is the lever for the two cases the marker cannot
 * cover: a marker left stale by an older tree, and a table dropped by hand
 * (measured on Boot 16 — `audit_log` gone, every admin write 500ing on it).
 */
function cmdMigrate(): void
{
    $output = new class () implements CliOutput {
        public function writeln(string $message): void
        {
            out(strip_tags($message));
        }
    };

    (new DatabaseMigrator())->run($output);
}

/**
 * Run the Scheduler timetable entries due now — the cron entry (`* * * * *
 * php bin/cms schedule:run`) that replaces the showcase's long-running
 * worker. Per-task lines plus the summary go to stdout; the exit code is 1
 * when any due task failed, else 0, so the cron daemon notices a poison
 * task instead of silently rotating past it.
 */
function cmdScheduleRun(): void
{
    if (!class_exists(\Modules\Scheduler\Interfaces\HTTP\SchedulerServices::class)) {
        fail('schedule:run needs the Scheduler module (bin/cms module:add Scheduler).');
    }

    // Delivery in this process, so the handler map is the one the tasks use.
    wire_module_handlers();

    $output = \Modules\Scheduler\Interfaces\HTTP\SchedulerServices::output(
        static function (string $message): void {
            out($message);
        },
    );

    $schedule = \Modules\Scheduler\Interfaces\HTTP\SchedulerServices::schedule();
    withQueueWork($schedule);

    exit(\Modules\Scheduler\Interfaces\HTTP\SchedulerServices::run($schedule, $output));
}

/**
 * Add the queue's worker to $schedule — HERE, not in the Scheduler module.
 *
 * Two reasons, one architectural and one operational:
 *
 *  - **Architectural.** Scheduler stays queue-agnostic: a timetable entry
 *    naming `QueueServices` inside the module would be a Scheduler → Queue
 *    edge in `module:show`, and the queue is not something every deployment
 *    has. The entry belongs to the composition, which is what this file is.
 *  - **Operational.** `queue.db` is created by a migrator, so a cron that
 *    fires before the first `bin/cms migrate` would otherwise fail a task
 *    every minute and redden every run for a reason the operator cannot see
 *    from the failure line. So the entry is skipped — with one line saying
 *    why — while the database is unmigrated.
 *
 * Every minute with a five-minute overlap guard, because `work()` is a batch
 * and a second tick landing on top of a slow batch is exactly what the guard
 * is for.
 *
 * @param \Modules\Scheduler\Scheduling\Schedule $schedule
 */
function withQueueWork($schedule): void
{
    if (!class_exists(\Modules\Queue\Interfaces\HTTP\QueueServices::class)) {
        return;
    }

    if (!queue_database_ready()) {
        out(sprintf(
            'queue:work skipped — %s has no `jobs` table yet (run: php bin/cms migrate).',
            queue_database_path(),
        ));

        return;
    }

    $schedule->call(static function (): void {
        \Modules\Queue\Interfaces\HTTP\QueueServices::work();
    })->everyMinute()->description('queue:work')->withoutOverlapping(5);
}

/**
 * Where the queue's database actually is — the `DB_QUEUE` override when the
 * deployment set one, `storage/data/queue.db` otherwise.
 *
 * Named separately from `queue_database_ready()` because the two answer
 * different questions, and the skip message has to quote the REAL path: a
 * line that says `storage/data/queue.db` while the deployment keeps its
 * database in /var/lib sends the operator to the wrong file.
 */
function queue_database_path(): string
{
    return \Modules\Core\Infrastructure\Paths\AppPaths::instance()->database('queue');
}

/**
 * Whether the queue's database carries the `jobs` table yet.
 *
 * A table lookup, not a file check: an operator who removed and reinstalled
 * the module has the file and no schema, and a file check would call that
 * ready and hand the cron a missing-table error every minute.
 */
function queue_database_ready(): bool
{
    try {
        $pdo = DatabaseConnectionManager::instance()->connection('queue');

        $statement = $pdo->query("SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'jobs'");
    } catch (\Throwable $e) {
        return false;
    }

    if (false === $statement) {
        return false;
    }

    return false !== $statement->fetchColumn();
}

/**
 * Work one batch of queued jobs — the queue's operator surface.
 *
 * `DatabaseQueue::work()` had no caller in this tree at all: the end-of-
 * request drain that ships today is the OUTBOX's, a different mechanism on a
 * different database with an idempotent handler, and no producer pushes a
 * Queue job yet. That is stated rather than papered over — until a producer
 * lands, this command has nothing to deliver and says so in one line.
 *
 * It exists because the alternative is worse: the only way to run a worker was
 * an inline `php` heredoc, which is not something an operator can put in
 * crontab and a support answer can point at. The handler pairing is wired
 * first, for the reason in the file header.
 *
 * @param list<string> $argv the full argv; options start at index 2
 */
function cmdQueueWork(array $argv): void
{
    if (!class_exists(\Modules\Queue\Interfaces\HTTP\QueueServices::class)) {
        fail('queue:work needs the Queue module (bin/cms module:add Queue).');
    }

    wire_module_handlers();

    $queue = null;
    $limit = 10;

    foreach (array_slice($argv, 2) as $argument) {
        if (str_starts_with($argument, '--limit=')) {
            $limit = max(1, (int) substr($argument, strlen('--limit=')));
        } elseif (!str_starts_with($argument, '--')) {
            $queue = $argument;
        }
    }

    $result = \Modules\Queue\Interfaces\HTTP\QueueServices::work($queue, $limit);

    out(sprintf(
        'Queue: processed=%d failed=%d (queue: %s, limit %d)',
        $result['processed'],
        $result['failed'],
        $queue ?? '(any)',
        $limit,
    ));

    if ($result['failed'] > 0) {
        out(sprintf(
            'Failed jobs are parked in failed_jobs — retry or drop them at /mark/queue%s.',
            null === $queue ? '' : ' (queue: ' . $queue . ')',
        ));
    }

    exit(\Modules\Queue\Interfaces\HTTP\QueueServices::exitCode($result));
}

/**
 * Delete the discovery cache — the next request rescans and rebuilds it.
 * The file is derived state (like the migration marker), so clearing it is
 * always safe; a missing file only costs one scan.
 */
function cmdDiscoveryClear(): void
{
    \Modules\Core\Application\Services\DiscoveryCache::clearCache();
    out('Discovery cache cleared.');
}

/**
 * Report whether the discovery cache exists, whether its fingerprint still
 * matches the current module set, and how many routes it holds.
 */
function cmdDiscoveryStatus(): void
{
    $status = \Modules\Core\Application\Services\DiscoveryCache::fromAppPaths()->status();

    out(sprintf('Exists:      %s', $status['exists'] ? 'yes' : 'no'));
    out(sprintf('Fresh:       %s', $status['fresh'] ? 'yes' : 'no'));
    out(sprintf('Routes:      %d', $status['routes']));
    out(sprintf('Middleware:  %d', $status['middleware']));
    out(sprintf('Fingerprint: %s', substr($status['fingerprint'], 0, 16) . '…'));
    out(sprintf('Version:     %d', $status['version']));
}

/** @param list<string> $argv */
function main(array $argv): void
{
    $command = $argv[1] ?? '';

    $installer = ModuleInstaller::fromAppPaths();
    $catalog = ModuleCatalog::fromAppPaths();

    switch ($command) {
        case 'module:list':
            cmdList($catalog);

            break;

        case 'module:show':
            if (!isset($argv[2])) {
                fail('module:show needs a module name.');
            }

            cmdShow($catalog, $argv[2]);

            break;

        case 'module:add':
            if (!isset($argv[2])) {
                fail('module:add needs a module name.');
            }

            cmdAdd($installer, $argv[2]);

            break;

        case 'module:remove':
            if (!isset($argv[2])) {
                fail('module:remove needs a module name.');
            }

            cmdRemove($installer, $argv[2], in_array('--force', $argv, true));

            break;

        case 'migrate':
            cmdMigrate();

            break;

        case 'schedule:run':
            cmdScheduleRun();

            break;

        case 'queue:work':
            cmdQueueWork($argv);

            break;

        case 'discovery:clear':
            cmdDiscoveryClear();

            break;

        case 'discovery:status':
            cmdDiscoveryStatus();

            break;

        default:
            usage();

            exit('' === $command ? 0 : 1);
    }
}

main($argv ?? []);
