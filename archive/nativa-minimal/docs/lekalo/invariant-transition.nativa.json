  "invariants": [
    {
      "invariantId": "nativa.invariant.article_gate_state",
      "stateSpaceId": "nativa.blog.article",
      "kind": "member_of_set",
      "allowedStates": [
        "members_only",
        "public"
      ],
      "description": "A served article gate state is exactly one of the two declared gate states."
    },
    {
      "invariantId": "nativa.invariant.comment_status_member",
      "stateSpaceId": "nativa.comments.moderation",
      "kind": "member_of_set",
      "allowedStates": [
        "approved",
        "pending",
        "rejected"
      ],
      "description": "A comment row status is always one of the three declared moderation states."
    },
    {
      "invariantId": "nativa.invariant.account_state_member",
      "stateSpaceId": "nativa.users.account",
      "kind": "member_of_set",
      "allowedStates": [
        "active",
        "inactive"
      ],
      "description": "An is_active account lifecycle state is exactly active or inactive."
    },
    {
      "invariantId": "nativa.invariant.comment_submitted_pending",
      "stateSpaceId": "nativa.comments.moderation",
      "kind": "field_value",
      "fields": [
        {
          "field": "status"
        }
      ],
      "predicate": {
        "op": "equal",
        "left": {
          "kind": "field",
          "field": "status"
        },
        "right": {
          "kind": "enum_member",
          "typeRef": "comments.status",
          "value": "pending"
        }
      },
      "description": "A freshly submitted comment row carries exactly the pending status."
    }
  ],
